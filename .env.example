ROBOCAR_HOST=127.0.0.1
ROBOCAR_PORT=5000
ROBOCAR_CAMERA_BACKEND=picamera2
ROBOCAR_CAMERA_INDEX=0
ROBOCAR_FRAME_WIDTH=640
ROBOCAR_FRAME_HEIGHT=480
ROBOCAR_MODEL_PATH=~/.cache/robocar/yolo11n.onnx
ROBOCAR_LABELS_PATH=
# auto: AI HAT+ when present, CPU otherwise; hailo, cpu or off
ROBOCAR_DETECTOR=auto
# Leave empty for the hailo-models YOLOv8s that suits the chip
ROBOCAR_HAILO_MODEL=
ROBOCAR_CONFIDENCE=0.35
ROBOCAR_NMS_THRESHOLD=0.45
ROBOCAR_HARDWARE_ENABLED=false
FREENOVE_SERVER_PATH=
ROBOCAR_MAX_MOTOR_DUTY=4095
ROBOCAR_COMMAND_TIMEOUT=1.0
